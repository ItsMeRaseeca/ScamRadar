# ==========================================
# ScamRadar Backend Environment Variables
# ==========================================

# Required for Deep Analysis (Google Gemini AI)
# Get your API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed CORS Origins (comma-separated for multiple origins, or *)
# Local development default: http://localhost:3000
# Production: https://your-app.vercel.app
FRONTEND_ORIGIN=http://localhost:3000

# Server Port (optional, defaults to 8000)
PORT=8000

# ==========================================
# ScamRadar Frontend Environment Variables
# ==========================================

# Base URL for ScamRadar Backend API
# Local development: http://localhost:8000
# Production: https://scamradar-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

